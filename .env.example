# =============================================================================
# MCP Business Assistant -- example configuration
#
# Copy to `.env` and edit. NEVER commit a real `.env`; it is gitignored.
# Defaults below are chosen so the stack runs end to end with NO credentials.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="MCP Business Assistant"
ENVIRONMENT=local                  # local | test | staging | production
DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=*                     # comma-separated list in production

# --- Authentication ----------------------------------------------------------
# Disabled by default for a frictionless demo. The app logs a warning at startup
# if this is false while ENVIRONMENT=production.
AUTH_ENABLED=false
# API_KEY=replace-with-a-long-random-value      # required when AUTH_ENABLED=true
DEMO_USER_EMAIL=demo@example.com

# --- Database ----------------------------------------------------------------
# Inside docker compose the host is the service name `db`.
DATABASE_URL=postgresql+asyncpg://mcp:mcp@db:5432/mcp_assistant
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
# Creates tables from ORM metadata on startup. Fine for dev/demo;
# use Alembic migrations in production (see alembic/README.md).
AUTO_CREATE_SCHEMA=true

# --- LLM provider ------------------------------------------------------------
# heuristic -> deterministic rule-based DEV MOCK, no API key, no network.
#              Lets the whole system be evaluated with `docker compose up`.
# openai | openrouter | openai_compatible -> real tool-calling model.
LLM_PROVIDER=heuristic
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://openrouter.ai/api/v1     # omit for OpenAI itself
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Agent -------------------------------------------------------------------
AGENT_MAX_ITERATIONS=6             # hard ceiling on plan->act loops per request
AGENT_TOOL_TIMEOUT_SECONDS=30
AGENT_HISTORY_LIMIT=20             # conversation turns replayed into the model

# --- MCP ---------------------------------------------------------------------
# stdio -> the API launches each MCP server as a subprocess (default).
# http  -> connect to independently deployed servers over Streamable HTTP.
MCP_TRANSPORT=stdio
MCP_ENABLED_SERVERS=crm,tasks,spreadsheets,email,calendar
MCP_STARTUP_TIMEOUT_SECONDS=45
MCP_CALL_TIMEOUT_SECONDS=30
MCP_HTTP_BASE_URL=http://localhost:9000
# When true the API refuses to start if any MCP server fails to connect.
# When false it starts in degraded mode and reports the failure on /health.
MCP_FAIL_FAST=false

# --- Approval / security -----------------------------------------------------
APPROVAL_TTL_MINUTES=30
# HIGH_RISK tools ALWAYS require human approval. Set this to true to hold WRITE
# tools (create_lead, create_task, add_sales_record) to the same bar.
REQUIRE_APPROVAL_FOR_WRITES=false

# --- Integrations ------------------------------------------------------------
# CRM: local (PostgreSQL-backed) or hubspot (real API; requires a token).
CRM_PROVIDER=local
# HUBSPOT_ACCESS_TOKEN=pat-na1-...

# Email: mock (DEV MOCK -- writes to a JSONL outbox, sends nothing) or smtp.
EMAIL_PROVIDER=mock
EMAIL_FROM_ADDRESS=assistant@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=assistant@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_USE_TLS=true

# Spreadsheets: local (PostgreSQL-backed) or google_sheets.
SPREADSHEET_PROVIDER=local
# GOOGLE_SHEETS_SPREADSHEET_ID=1AbC...
# GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json

# --- Observability -----------------------------------------------------------
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                    # json for shipping, console for local reading
